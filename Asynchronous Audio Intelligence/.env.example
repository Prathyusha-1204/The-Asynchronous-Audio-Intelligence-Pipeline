# AWS Credentials (local development only)
# Remove these for production Lambda — use IAM roles instead
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# S3 Bucket Names
S3_INPUT_BUCKET=audio-pipeline-input-bucket-[your-suffix]
S3_OUTPUT_BUCKET=audio-pipeline-output-bucket-[your-suffix]
